# Required – PostgreSQL connection string for Prisma (schema.prisma + db.ts)
# For Prisma Postgres use the POOLED host (pooled.db.prisma.io) for the app,
# the DIRECT host (db.prisma.io) is auto-upgraded to pooled at runtime by db.ts.
DATABASE_URL=

# Optional alias – same value as DATABASE_URL (used by db.ts; falls back to DATABASE_URL)
PREONE_PG_URL=

# Optional legacy fallback – Vercel/Neon style URL (used by db.ts if DATABASE_URL/PREONE_PG_URL unset)
POSTGRES_URL=

# Required – shared secret for JWT signing (set to a long random string)
JWT_SECRET=

# Optional – Node environment (Vercel sets this automatically; do not set manually)
NODE_ENV=

# Optional – email provider
SMTP_HOST=
SENDGRID_API_KEY=

# Optional – SMS provider
SMS_API_KEY=
TWILIO_AUTH_TOKEN=

# Optional – WhatsApp provider
WHATSAPP_API_TOKEN=
